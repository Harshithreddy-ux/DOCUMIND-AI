# DocuMind AI — Environment Variables
# =====================================
# Copy this file: cp .env.example .env
# All defaults below match docker-compose.yml and work out of the box.

# ── Ollama ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b-instruct-q4_K_M
OLLAMA_MODEL_EMBED=nomic-embed-text

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=documind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ── Neo4j ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── FastAPI ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit ─────────────────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── DocuMind Settings ────────────────────────────────────────────────
# Confidence threshold (0.0–1.0); below this → HITL review required
CONFIDENCE_THRESHOLD=0.80
# Amount anomaly multiplier; flag invoice if > X × vendor's average
ANOMALY_MULTIPLIER=2.5
